{
  "netlist": "dc_family.spice",
  "models": {
    "pdk": "ihp-sg13g2"
  },
  "corners": {
    "process": [
      {
        "name": "hbt_typ",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          }
        ]
      },
      {
        "name": "hbt_bcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          }
        ]
      },
      {
        "name": "hbt_wcs",
        "sections": [
          {
            "lib": "libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          }
        ]
      }
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "Vc 0.0 2.0 0.1"
  },
  "options": {
    "timeout_s": 300,
    "keep_artifacts": true,
    "waveforms": true,
    "capture_only": true,
    "save_mode": "netlist",
    "ngspice_init": [
      "set numdgt=8"
    ]
  },
  "batch": {
    "capacity_wait_s": 600
  }
}
